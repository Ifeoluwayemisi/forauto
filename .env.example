# ─────────────────────────────────────────────────────────────
# FORauto — Environment Variables
#
# Copy to `.env` in the repository root and fill in real values.
# `.env` is git-ignored. Never commit real credentials.
#
# Only variables the application actually reads are listed here.
# See docs/ROADMAP.md §13 and docs/ARCHITECTURE.md §42.
# ─────────────────────────────────────────────────────────────


# ─── Runtime ────────────────────────────────────────────────
# development | test | staging | production
NODE_ENV=development

# API server port.
PORT=4000

# debug | info | warn | error
# Logs are emitted as structured JSON.
LOG_LEVEL=info


# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string.
# Local example: postgresql://forauto:forauto@localhost:5432/forauto
DATABASE_URL=


# ─── API / Web ──────────────────────────────────────────────
# Canonical server-side API base, including the version prefix.
API_BASE_URL=http://localhost:4000/api/v1

# Browser-visible API base. Only ever a public value.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Public origin of the Next.js app, read server-side for canonical and
# Open Graph URLs. Not exposed to the browser.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API.
# Production must never be "*".
CORS_ORIGINS=http://localhost:3000


# ─── Authentication ─────────────────────────────────────────
# REQUIRED BEFORE AUTH ENDPOINTS SHIP — NOT YET WIRED.
# Random value, 32+ characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=


# ─── Business contact information ───────────────────────────
# UNCONFIRMED. See docs/ROADMAP.md §5 — these have not been supplied
# by the business yet and MUST NOT be invented. Leave blank until
# confirmed, then set here. No UI may hard-code a fallback value.
#
# E.164 / Nigerian format, digits only for the wa.me deep link
# (e.g. 234XXXXXXXXX). See AGENTS.md §19 for normalisation.
WHATSAPP_NUMBER=
PHONE_NUMBER=
